# ==============================================================================
# Open WebUI Production Environment Configuration
# Copy this file to .env and replace placeholders with real credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core WebUI & Branding
# ------------------------------------------------------------------------------
WEBUI_NAME="سامانه هوشمند جزوات و پژوهش دانشگاه"
WEBUI_SECRET_KEY="generate_with_openssl_rand_hex_32"
WEBUI_URL="https://your-domain.com"
WEBUI_AUTH=true
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=user
SHOW_ADMIN_DETAILS=false
ENABLE_COMMUNITY_SHARING=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=webui_user
POSTGRES_PASSWORD=replace_with_strong_database_password_here
POSTGRES_DB=openwebui
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. LLM Gateway / Provider Configuration
# ------------------------------------------------------------------------------
OPENAI_API_BASE_URL=https://ai.gcat.ir/v1
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. RAG & Vector Embeddings Configuration
# ------------------------------------------------------------------------------
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=https://ai.gcat.ir/v1
RAG_OPENAI_API_KEY=your_openai_api_key_here
RAG_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_RAG_HYBRID_SEARCH=true
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ------------------------------------------------------------------------------
# 5. Code Execution & Interpreter (Pyodide / Python Runner)
# ------------------------------------------------------------------------------
ENABLE_CODE_INTERPRETER=true

# ------------------------------------------------------------------------------
# 6. Web Search & Agentic Deep Research
# ------------------------------------------------------------------------------
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=duckduckgo
WEB_SEARCH_RESULT_COUNT=5

# ------------------------------------------------------------------------------
# 8. OAuth / SSO (gcat.ir identity provider)
# ------------------------------------------------------------------------------
# Required by docker-compose.override.yml. Must match the client registered
# with the OmniRoute panel (ai.gcat.ir) for client_id "chat-webui".
OAUTH_CLIENT_SECRET=replace_with_your_oauth_client_secret

# ------------------------------------------------------------------------------
# 9. Reverse Proxy / Domain (Caddy)
# ------------------------------------------------------------------------------
DOMAIN=your-domain.com
